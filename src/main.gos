// Feather's process ownership and event loop. Application behavior lives in
// app.gos; windows.gos owns the native show, focus, and hide operations.
use std::{env, errors}
use std::sync::{channel, channel_unbounded, Receiver, Sender, Shared}
use gui
use gui::UiMsg
use app
use catalog
use daemon
use fixture
use hotkey
use instance
use wake
use windows

const USAGE: String = """
Usage: feather-launcher [--daemon]

Start Feather, or show the instance that is already running.

  --daemon       Start hidden in the background, detached from the terminal
  --fixture      Run the headless UI checks (add --quit-from-main to quit
                 from the launcher instead of Settings)
  -h, --help     Show this help
  -V, --version  Show the version
"""

// Arguments Feather accepts; `--daemon-child` is the re-executed daemon.
const KNOWN: [String; 8] = ["--daemon", "--daemon-child", "--fixture", "--quit-from-main", "-h", "--help", "-V", "--version"]

fn main() -> Result<(), errors::Error> {
    let args = env::args()
    if args.contains("-h") || args.contains("--help") {
        println(USAGE)
        return Ok(())
    }
    if args.contains("-V") || args.contains("--version") {
        println(f"feather-launcher {app::APP_VERSION}")
        return Ok(())
    }
    for arg in args {
        if !KNOWN.contains(arg) {
            eprintln(USAGE)
            return Err(errors::new(f"unknown argument {arg}"))
        }
    }
    if args.contains("--fixture") { return run(None) }
    if args.contains("--daemon") { return daemon::start() }
    let Some(owner) = instance::acquire(!daemon::is_child())? else { return Ok(()) }
    let result = run(Some(owner))
    instance::release(owner)
    result
}

fn run(owner: Option<i32>) -> Result<(), errors::Error> {
    hotkey::init()?
    let mut s = gui::start("Feather", app::APP_ID)?
    let result = run_session(s, owner)
    s.shutdown()
    result
}

fn run_session(mut s: gui::Session, owner: Option<i32>) -> Result<(), errors::Error> {
    windows::prepare(s)?
    let is_fixture = env::args().contains("--fixture")
    let mut initial = app::init(is_fixture)
    initial.shown = !daemon::is_child()
    let shown = Shared::new(if initial.shown { 1 } else { 0 }) // 0 hidden, 1 shown, 2 quit.
    let activations = Shared::new(0)
    // Wayland activation tokens of requests to show the launcher.
    let tokens, token_rx = channel_unbounded::<String>()
    let tx, rx = channel(16)
    let rebind = wake::new()?
    defer rebind.close()
    let mut sent = #[app::DEFAULT_LAUNCH_KEY]
    let mut cell = #[initial]
    s.set_shell(
        |msg: UiMsg| {
            if let UiMsg::Custom(id, text) = msg {
                if id == "activate" { let _ = activations.update(|n| n + 1) }
                if (id == "activate" || id == "hotkey") && text != "" { let _ = tokens.send(text) }
            }
            cell[0] = app::update(cell[0], msg)
            let m = cell[0]
            let _ = shown.update(|_| if m.quit { 2 } else if m.shown { 1 } else { 0 })
            let binding = if m.capturing_shortcut { hotkey::CAPTURE_PAUSE } else { m.launch_key }
            if binding != sent[0] {
                sent[0] = binding
                let _ = tx.send(binding)
                rebind.signal()
            }
        }
        |window: String| app::view(cell[0], window)
        |_window: String| app::commands(cell[0])
    )
    s.emit(UiMsg::Text("run", ""))
    s.flush()?
    if is_fixture { return fixture::run(s, shown, rx) }
    daemon::ready()?
    serve(s, shown, activations, token_rx, rx, rebind, owner)
}

// The hotkey and instance watchers block in poll(2), so every child gets its
// own thread. `shutdown` releases them; the cohort joins all background work
// before run() shuts down the GUI session, on error paths too.
fn serve(s: gui::Session, shown: Shared<i64>, activations: Shared<i64>, tokens: Receiver<String>, updates: Receiver<String>, rebind: wake::Wake, owner: Option<i32>) -> Result<(), errors::Error> {
    let mailbox = s.mailbox()
    let shutdown = wake::new()?
    defer shutdown.close()
    let checks, checks_rx = channel_unbounded::<i64>()
    let mut result = Ok(())
    let joined = cohort(isolation: Isolation::Thread) {
        spawn(|| catalog::watch(mailbox, checks_rx))
        spawn(|| hotkey::watch(mailbox, updates, rebind, shutdown, app::DEFAULT_LAUNCH_KEY))
        spawn(|| if let Some(fd) = owner { instance::watch(fd, mailbox, shutdown) } else { Ok(()) })
        result = drive(s, shown, activations, tokens, checks)
        checks.close()
        shutdown.signal()
    }
    result?
    joined
}

// Each hidden-to-shown change asks the catalog watcher to look for changed
// desktop entries.
fn drive(mut s: gui::Session, shown: Shared<i64>, activations: Shared<i64>, tokens: Receiver<String>, checks: Sender<i64>) -> Result<(), errors::Error> {
    // Show and take focus before waiting for the first platform event, with
    // the activation token this process was launched with.
    let mut up = shown.get() == 1
    if up { windows::show(s, env::var("XDG_ACTIVATION_TOKEN").unwrap_or(""))? }
    let mut activated = 0
    // The newest request's token; a token is single-use, so a hide drops it.
    let mut token = ""
    loop {
        let more = s.step()?
        while let Some(t) = tokens.try_recv() { token = t }
        let want = shown.get()
        if want == 2 { break }
        let next_activation = activations.get()
        if want == 1 && !up { let _ = checks.send(1) }
        if want == 1 && (!up || next_activation != activated) {
            windows::show(s, token)?
            token = ""
        }
        else if want == 0 && up {
            windows::hide(s)?
            token = ""
        }
        up = want == 1
        activated = next_activation
        if !more { break }
    }
    Ok(())
}
